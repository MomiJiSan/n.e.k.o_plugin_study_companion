{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neko.local/knowledge-dungeon/bridge-requests-v1.schema.json",
  "title": "Knowledge Dungeon bridge request envelopes v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "bridge_protocol_version"],
  "properties": {
    "operation": {"enum": ["bootstrap", "create_run", "get_run", "perform_action"]},
    "bridge_protocol_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^run-[0-9a-f]{24}$"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "subject_id": {"const": "math"},
    "scenario_id": {"const": "calculus_v0_1"},
    "expected_state_version": {"type": "integer", "minimum": 1},
    "action_id": {
      "type": "string",
      "pattern": "^(select_node:[a-z0-9][a-z0-9._-]*|enter_selected_node|play_card:[a-z0-9][a-z0-9._-]*|end_turn|choose_reward:[a-z0-9][a-z0-9._-]*|abandon_run|finish_run)$"
    }
  },
  "oneOf": [
    {
      "properties": {"operation": {"const": "bootstrap"}},
      "not": {
        "anyOf": [
          {"required": ["run_id"]},
          {"required": ["request_id"]},
          {"required": ["subject_id"]},
          {"required": ["scenario_id"]},
          {"required": ["expected_state_version"]},
          {"required": ["action_id"]}
        ]
      }
    },
    {
      "properties": {"operation": {"const": "create_run"}},
      "required": ["request_id", "subject_id", "scenario_id"],
      "not": {
        "anyOf": [
          {"required": ["run_id"]},
          {"required": ["expected_state_version"]},
          {"required": ["action_id"]}
        ]
      }
    },
    {
      "properties": {"operation": {"const": "get_run"}},
      "required": ["run_id"],
      "not": {
        "anyOf": [
          {"required": ["request_id"]},
          {"required": ["subject_id"]},
          {"required": ["scenario_id"]},
          {"required": ["expected_state_version"]},
          {"required": ["action_id"]}
        ]
      }
    },
    {
      "properties": {"operation": {"const": "perform_action"}},
      "required": ["run_id", "request_id", "expected_state_version", "action_id"],
      "not": {
        "anyOf": [
          {"required": ["subject_id"]},
          {"required": ["scenario_id"]}
        ]
      }
    }
  ]
}
